---
import { formatScore } from "../lib/score";
import ReviewCard from "./ReviewCard.astro";

interface Props {
    title: string;
    description?: string;
    thumb?: string;
    url?: URL;
    score?: number | string;
    author?: string;
    type?: "article" | "home";
    variant?: "default" | "small";
    featured?: { data: { title: string; thumb?: string; score?: number | null } }[];
}

const {
    title,
    description,
    thumb,
    url = Astro.url,
    score,
    author,
    type = "article",
    variant = "default",
    featured = [],
} = Astro.props;

// Generate a unique ID for the card to allow multiple instances
const cardId = `card-${Math.random().toString(36).substr(2, 9)}`;

const encodedUrl = encodeURIComponent(url.href);
const encodedTitle = encodeURIComponent(title);

// What gets pasted next to the shared image, and the image's file name.
const hasScore = score !== undefined && score !== null && score !== "";
const caption =
    type === "home"
        ? `PlayTested: no-nonsense game reviews. ${url.href}`
        : `${title}${hasScore ? ` (${formatScore(score!)}/10)` : ""}. Read the full review on PlayTested: ${url.href}`;
const fileName = `playtested-${(type === "home" ? "reviews" : title).toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 60) || "card"}.png`;

const shareLinks = [
    {
        name: "Facebook",
        icon: "M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z",
        href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
        color: "hover:bg-blue-600",
    },
    {
        name: "Twitter",
        icon: "M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z",
        href: `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`,
        color: "hover:bg-sky-500",
    },
    {
        name: "WhatsApp",
        icon: "M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.008-.57-.008-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z",
        href: `https://wa.me/?text=${encodedTitle}%20${encodedUrl}`,
        color: "hover:bg-green-500",
    },
    {
        name: "Messenger",
        icon: "M12 2C6.48 2 2 6.03 2 11c0 2.87 1.56 5.47 3.99 7.15l-1 3.85 4.31-1.34c.89.24 1.82.34 2.7.34 5.52 0 10-4.03 10-9s-4.48-9-10-9zm1.7 11l-2.5-2.7-4.9 2.7 5.4-5.7 2.5 2.7 4.9-2.7-5.4 5.7z",
        href: `fb-messenger://share/?link=${encodedUrl}`,
        mobileOnly: true,
        color: "hover:bg-purple-500",
    },
    {
        name: "Telegram",
        icon: "M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.48-1.02-2.38-1.64-1.04-.72-.37-1.12.23-1.74.15-.16 2.81-2.57 2.86-2.79.01-.05-.01-.33-.35-.23-.42.12-6.52 4.16-6.84 4.01-.76-.36-1.51-.55-2.28-.57-.84-.03-2.1.41-2.19.41.9-.38 3.51-1.47 7.02-2.79 3.32-1.24 4.02-1.46 4.47-1.46.2 0 .44.04.59.16.13.1.17.24.18.39 0 .04 0 .09.01.14z",
        href: `https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}`,
        color: "hover:bg-blue-400",
    },
];
---

<div
    class={`social-share-container ${variant === "small" ? "inline-block" : "flex flex-wrap gap-2"}`}
>
    {
        variant === "default" && (
            <>
                {shareLinks.map((link) => (
                    <a
                        href={link.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class={`inline-flex items-center justify-center w-8 h-8 md:w-10 md:h-10 rounded-full bg-gray-100 dark:bg-slate-700 text-gray-600 dark:text-gray-300 transition-colors ${link.color} hover:text-white`}
                        title={`Share on ${link.name}`}
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            class="w-4 h-4 md:w-5 md:h-5 pointer-events-none"
                            set:html={`<path d="${link.icon}"/>`}
                        />
                    </a>
                ))}

                <button
                    class="copy-link-btn inline-flex items-center justify-center w-8 h-8 md:w-10 md:h-10 rounded-full bg-gray-100 dark:bg-slate-700 text-gray-600 dark:text-gray-300 transition-colors hover:bg-gray-500 hover:text-white"
                    title="Copy Link"
                    data-url={url}
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-4 h-4 md:w-5 md:h-5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
                        />
                    </svg>
                </button>
            </>
        )
    }

    {
        variant === "default" && (
            <button
                type="button"
                class="share-open-btn inline-flex items-center gap-1.5 h-8 md:h-10 px-3 md:px-4 rounded-full bg-blue-600 text-white text-sm font-semibold shadow-sm transition-colors hover:bg-blue-700 motion-safe:active:scale-95"
                data-target={cardId}
                aria-haspopup="dialog"
            >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.7 10.7l6.6-3.4M8.7 13.3l6.6 3.4M18 8a3 3 0 100-6 3 3 0 000 6zM6 15a3 3 0 100-6 3 3 0 000 6zm12 7a3 3 0 100-6 3 3 0 000 6z" />
                </svg>
                Share
            </button>
        )
    }

    <button
        type="button"
        class="share-open-btn inline-flex items-center justify-center w-8 h-8 md:w-10 md:h-10 rounded-full bg-gray-100 dark:bg-slate-700 text-gray-600 dark:text-gray-300 transition-colors hover:bg-indigo-500 hover:text-white"
        title="Share card image"
        aria-label="Share card image"
        aria-haspopup="dialog"
        data-target={cardId}
    >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 md:w-5 md:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
        </svg>
    </button>
</div>

<div class="sr-only">
    <ReviewCard
        id={cardId}
        title={title}
        description={description}
        thumb={thumb}
        score={score}
        url={url}
        type={type}
        featured={featured}
    />
</div>

<!-- Share dialog: the card image preview, and the ways to get it out. -->
<dialog
    id={`${cardId}-dialog`}
    class="share-dialog m-auto w-[min(44rem,calc(100vw-2rem))] max-h-[calc(100dvh-2rem)] overflow-y-auto rounded-3xl bg-white p-0 text-gray-900 shadow-2xl ring-1 ring-black/10 backdrop:bg-black/70 backdrop:backdrop-blur-sm dark:bg-slate-800 dark:text-slate-100 dark:ring-white/10"
    aria-labelledby={`${cardId}-dialog-title`}
    data-card={cardId}
    data-url={url.href}
    data-title={type === "home" ? "PlayTested" : title}
    data-file={fileName}
>
    <div class="p-4 md:p-6">
        <div class="mb-4 flex items-center justify-between gap-3">
            <h3 id={`${cardId}-dialog-title`} class="m-0 text-lg font-extrabold md:text-xl">
                {type === "home" ? "Share PlayTested" : "Share this review"}
            </h3>
            <button type="button" data-act="close" class="grid h-10 w-10 place-items-center rounded-xl bg-gray-100 text-gray-600 transition hover:bg-gray-200 dark:bg-slate-700 dark:text-slate-300 dark:hover:bg-slate-600" aria-label="Close">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <div class="mb-4 grid aspect-[1200/630] place-items-center overflow-hidden rounded-2xl bg-gray-100 dark:bg-slate-900">
            <img data-preview alt="Share image preview" class="hidden h-full w-full object-contain" />
            <p data-loading class="m-0 px-6 text-center text-sm text-gray-500 dark:text-slate-400">Creating image…</p>
        </div>

        <div class="mb-3 grid grid-cols-2 gap-2 sm:grid-cols-4" data-actions>
            <button type="button" data-act="share" class="hidden min-h-11 rounded-xl bg-blue-600 px-3 text-sm font-semibold text-white transition hover:bg-blue-700 disabled:opacity-50">Share</button>
            <button type="button" data-act="download" disabled class="min-h-11 rounded-xl bg-gray-100 px-3 text-sm font-semibold transition hover:bg-gray-200 disabled:opacity-50 dark:bg-slate-700 dark:hover:bg-slate-600">Download image</button>
            <button type="button" data-act="link" class="min-h-11 rounded-xl bg-gray-100 px-3 text-sm font-semibold transition hover:bg-gray-200 dark:bg-slate-700 dark:hover:bg-slate-600">Copy link</button>
            <button type="button" data-act="caption" class="min-h-11 rounded-xl bg-gray-100 px-3 text-sm font-semibold transition hover:bg-gray-200 dark:bg-slate-700 dark:hover:bg-slate-600">Copy caption</button>
        </div>

        <p data-caption class="m-0 select-all break-words rounded-xl bg-gray-100 px-3 py-2 text-xs text-gray-600 dark:bg-slate-900 dark:text-slate-400">{caption}</p>
        <p data-status role="status" class="m-0 mt-2 min-h-[1rem] text-xs font-medium text-blue-700 dark:text-blue-300"></p>
    </div>
</dialog>

<script>
    import * as htmlToImage from "html-to-image";

    // One rendered image per card per page view.
    const rendered = new Map<string, Promise<Blob>>();

    async function renderCard(card: HTMLElement): Promise<Blob> {
        card.style.opacity = "1";
        card.style.zIndex = "-50";
        try {
            await document.fonts?.ready;
            await new Promise((r) => setTimeout(r, 100));
            const opts = { pixelRatio: 2, backgroundColor: "#0B1020", cacheBust: false };
            // Safari sometimes paints images only on the second pass.
            if (/^((?!chrome|android).)*safari/i.test(navigator.userAgent)) await htmlToImage.toBlob(card, opts).catch(() => null);
            const blob = await htmlToImage.toBlob(card, opts);
            if (!blob) throw new Error("No image");
            return blob;
        } finally {
            card.style.opacity = "0";
        }
    }

    function cardBlob(cardId: string): Promise<Blob> {
        let p = rendered.get(cardId);
        if (!p) {
            const card = document.getElementById(cardId);
            p = card ? renderCard(card) : Promise.reject(new Error("No card"));
            p.catch(() => rendered.delete(cardId));
            rendered.set(cardId, p);
        }
        return p;
    }

    async function copy(text: string) {
        try {
            await navigator.clipboard.writeText(text);
            return true;
        } catch {
            return false;
        }
    }

    function openDialog(cardId: string, opener: HTMLElement) {
        const dialog = document.getElementById(`${cardId}-dialog`) as HTMLDialogElement | null;
        if (!dialog) return;
        const $ = <T extends HTMLElement>(sel: string) => dialog.querySelector<T>(sel)!;
        const preview = $<HTMLImageElement>("[data-preview]");
        const loading = $("[data-loading]");
        const status = $("[data-status]");
        const shareBtn = $<HTMLButtonElement>('[data-act="share"]');
        const downloadBtn = $<HTMLButtonElement>('[data-act="download"]');
        const say = (msg: string) => (status.textContent = msg);

        if (!dialog.dataset.bound) {
            dialog.dataset.bound = "1";
            const url = dialog.dataset.url || location.href;
            const caption = $("[data-caption]").textContent?.trim() || url;
            const fileName = dialog.dataset.file || "playtested.png";
            let blob: Blob | null = null;
            let objectUrl = "";

            dialog.addEventListener("click", (e) => {
                if (e.target === dialog) dialog.close(); // backdrop
            });
            dialog.addEventListener("close", () => {
                const back = (dialog as HTMLDialogElement & { _opener?: HTMLElement })._opener;
                if (back?.isConnected) back.focus();
            });
            $('[data-act="close"]').addEventListener("click", () => dialog.close());

            $('[data-act="link"]').addEventListener("click", async () =>
                say((await copy(url)) ? "Link copied. It opens this page." : "Couldn't copy automatically. Select the caption below instead."),
            );
            $('[data-act="caption"]').addEventListener("click", async () =>
                say((await copy(caption)) ? "Caption copied. Paste it with the image." : "Couldn't copy automatically. Select the caption below instead."),
            );
            downloadBtn.addEventListener("click", () => {
                if (!objectUrl) return;
                const a = document.createElement("a");
                a.href = objectUrl;
                a.download = fileName;
                document.body.appendChild(a);
                a.click();
                a.remove();
                say("Image downloaded.");
            });
            shareBtn.addEventListener("click", async () => {
                if (!blob) return;
                const file = new File([blob], fileName, { type: "image/png" });
                try {
                    await navigator.share({ files: [file], title: dialog.dataset.title, text: caption, url });
                    say("Shared.");
                } catch (e) {
                    if ((e as Error)?.name !== "AbortError") say("Sharing didn't work here. Try Download image instead.");
                }
            });

            cardBlob(cardId)
                .then((b) => {
                    blob = b;
                    objectUrl = URL.createObjectURL(b);
                    preview.src = objectUrl;
                    preview.classList.remove("hidden");
                    loading.classList.add("hidden");
                    downloadBtn.disabled = false;
                    const file = new File([b], fileName, { type: "image/png" });
                    if (navigator.canShare?.({ files: [file] })) shareBtn.classList.remove("hidden");
                })
                .catch(() => {
                    loading.textContent = "The image couldn't be created in this browser. You can still copy the link or caption.";
                });
            document.addEventListener("astro:before-swap", () => objectUrl && URL.revokeObjectURL(objectUrl), { once: true });
        }

        (dialog as HTMLDialogElement & { _opener?: HTMLElement })._opener = opener;
        say("");
        dialog.showModal();
        ($<HTMLButtonElement>('[data-act="close"]')).focus();
    }

    function initSocialShare() {
        // Copy-link icon in the share bar
        document.querySelectorAll<HTMLElement>(".copy-link-btn").forEach((btn) => {
            if (btn.dataset.bound) return;
            btn.dataset.bound = "1";
            btn.addEventListener("click", async () => {
                const url = btn.dataset.url;
                if (!url || !(await copy(url))) return;
                const originalHtml = btn.innerHTML;
                btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>`;
                setTimeout(() => (btn.innerHTML = originalHtml), 2000);
            });
        });

        // Share / card buttons open the share dialog
        document.querySelectorAll<HTMLElement>(".share-open-btn").forEach((btn) => {
            if (btn.dataset.bound) return;
            btn.dataset.bound = "1";
            btn.addEventListener("click", () => {
                const target = btn.dataset.target;
                if (target) openDialog(target, btn);
            });
        });
    }

    initSocialShare();
    document.addEventListener("astro:page-load", initSocialShare);
</script>
