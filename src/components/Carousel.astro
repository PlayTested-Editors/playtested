---
import { vtName } from "../lib/transitions";

export interface Props {
  images: string[];
  caption?: string;
  /** Shared-element name for the main image (it is the article hero). */
  heroName?: string;
  /** Above the fold: load the first image eagerly at high priority. */
  priority?: boolean;
}

const { images, caption, heroName, priority = false } = Astro.props as Props;
const id = `carousel-${Math.random().toString(36).substring(2, 9)}`;
const imgsJSON = JSON.stringify(images);
const markLoaded = "this.classList.add('is-loaded')";
const many = images.length > 1;
---

{images.length > 0 && (
  <div id={id} data-current="0" class="not-prose w-full max-w-[900px] mx-auto">
    <!-- Main image: a fixed 16:9 frame, so the page doesn't jump between shots -->
    <div class="relative aspect-video w-full overflow-hidden rounded-xl bg-slate-900 img-skeleton touch-pan-y group" data-carousel-stage>
      <img
        src={images[0]}
        alt={many ? `Screenshot 1 of ${images.length}` : "Screenshot"}
        width="1600"
        height="900"
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : "auto"}
        decoding="async"
        class:list={["main-image gallery-main no-limit img-fade absolute inset-0 m-0 h-full w-full object-contain cursor-zoom-in", heroName && "vt-morph"]}
        style={heroName ? `view-transition-name: ${vtName(heroName)}` : undefined}
        onload={markLoaded}
        onerror={markLoaded}
        tabindex="0"
        role="button"
        aria-haspopup="dialog"
        aria-label="View image full screen"
      />

      {many && (
        <span data-counter class="pointer-events-none absolute left-2 top-2 z-20 rounded-full bg-black/60 px-2.5 py-0.5 text-xs font-semibold tabular-nums text-white backdrop-blur-sm">
          1 / {images.length}
        </span>
      )}
      <button type="button" data-expand class="absolute right-2 top-2 z-20 rounded-full bg-black/50 p-1.5 text-white backdrop-blur-sm transition hover:bg-black/70 motion-safe:active:scale-90" aria-label="View full screen">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4h4M20 8V4h-4M4 16v4h4M20 16v4h-4" />
        </svg>
      </button>

      {many && (
        <>
          <button type="button" id={`${id}-prev`} class="absolute left-2 top-1/2 z-20 -translate-y-1/2 rounded-full bg-black/45 p-2 text-white shadow-sm backdrop-blur-sm transition hover:bg-black/65 motion-safe:active:scale-90" aria-label="Previous image">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
          <button type="button" id={`${id}-next`} class="absolute right-2 top-1/2 z-20 -translate-y-1/2 rounded-full bg-black/45 p-2 text-white shadow-sm backdrop-blur-sm transition hover:bg-black/65 motion-safe:active:scale-90" aria-label="Next image">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </>
      )}
    </div>

    <!-- Thumbnails: one scrolling row -->
    {many && (
      <div data-strip class="gallery-strip mt-2 flex gap-2 overflow-x-auto scroll-px-1 snap-x p-0.5 pb-1">
        {images.map((src, i) => (
          <button
            type="button"
            data-index={i}
            aria-label={`Show image ${i + 1} of ${images.length}`}
            aria-current={i === 0 ? "true" : undefined}
            class:list={[
              "thumbnail relative aspect-video w-[23%] min-w-[72px] shrink-0 snap-start overflow-hidden rounded-md bg-slate-200 ring-2 ring-offset-0 transition duration-200 dark:bg-slate-700 motion-safe:active:scale-95",
              i === 0 ? "ring-blue-500 opacity-100" : "ring-transparent opacity-60 hover:opacity-100",
            ]}
          >
            <img src={src} alt="" width="160" height="90" loading="lazy" decoding="async" class="no-limit absolute inset-0 m-0 h-full w-full object-cover" />
          </button>
        ))}
      </div>
    )}

    {caption && <div class="mt-3 text-center text-sm text-gray-600 dark:text-gray-300">{caption}</div>}

    <!-- Lightbox -->
    <div
      id={`${id}-lightbox`}
      role="dialog"
      aria-modal="true"
      aria-label="Image viewer"
      class="fixed inset-0 z-[100] flex items-center justify-center bg-black/90 backdrop-blur-sm hidden transition-opacity duration-300 opacity-0 cursor-zoom-out touch-pan-y"
    >
      <button type="button" id={`${id}-lb-close`} class="absolute right-4 top-4 z-[110] cursor-pointer rounded-full bg-white/10 p-3 text-white backdrop-blur-sm transition hover:bg-white/20 motion-safe:active:scale-90" aria-label="Close image viewer">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      {many && (
        <button type="button" id={`${id}-lb-prev`} class="absolute left-4 top-1/2 z-[110] -translate-y-1/2 cursor-pointer rounded-full bg-white/10 p-3 text-white backdrop-blur-sm transition hover:bg-white/20 motion-safe:active:scale-90" aria-label="Previous image">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
      )}
      <img id={`${id}-lightbox-img`} src="" alt="" class="no-limit max-h-[88vh] max-w-[95vw] scale-95 rounded-lg object-contain shadow-2xl transition-transform duration-300 ease-out" />
      {many && (
        <button type="button" id={`${id}-lb-next`} class="absolute right-4 top-1/2 z-[110] -translate-y-1/2 cursor-pointer rounded-full bg-white/10 p-3 text-white backdrop-blur-sm transition hover:bg-white/20 motion-safe:active:scale-90" aria-label="Next image">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      )}
      {many && (
        <span data-lb-counter class="absolute bottom-4 left-1/2 -translate-x-1/2 rounded-full bg-white/10 px-3 py-1 text-sm font-semibold tabular-nums text-white">1 / {images.length}</span>
      )}
    </div>

    <script define:vars={{ id, imgsJSON }}>
      function initCarousel() {
        const carousel = document.getElementById(id);
        // Bind once per rendered carousel (this runs on load and on every page-load).
        if (!carousel || carousel.dataset.ready) return;
        carousel.dataset.ready = "1";

        const stage = carousel.querySelector("[data-carousel-stage]");
        const mainImg = carousel.querySelector(".main-image");
        const strip = carousel.querySelector("[data-strip]");
        const counter = carousel.querySelector("[data-counter]");
        const expand = carousel.querySelector("[data-expand]");
        const lightbox = document.getElementById(`${id}-lightbox`);
        const lightboxImg = document.getElementById(`${id}-lightbox-img`);
        const lbCounter = lightbox?.querySelector("[data-lb-counter]");
        const prevBtn = document.getElementById(`${id}-prev`);
        const nextBtn = document.getElementById(`${id}-next`);
        const lbPrev = document.getElementById(`${id}-lb-prev`);
        const lbNext = document.getElementById(`${id}-lb-next`);
        const lbClose = document.getElementById(`${id}-lb-close`);
        const thumbnails = [...carousel.querySelectorAll(".thumbnail")];
        if (!mainImg || !lightbox || !lightboxImg) return;

        const images = JSON.parse(imgsJSON);
        const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)");
        let currentIndex = 0;
        let swapToken = 0;

        const preload = (i) => {
          if (images.length < 2) return;
          const img = new Image();
          img.src = images[(i + images.length) % images.length];
        };

        const highlight = (index) => {
          thumbnails.forEach((t, i) => {
            const active = i === index;
            t.classList.toggle("ring-blue-500", active);
            t.classList.toggle("opacity-100", active);
            t.classList.toggle("ring-transparent", !active);
            t.classList.toggle("opacity-60", !active);
            if (active) t.setAttribute("aria-current", "true");
            else t.removeAttribute("aria-current");
          });
          const label = `${index + 1} / ${images.length}`;
          if (counter) counter.textContent = label;
          if (lbCounter) lbCounter.textContent = label;
          mainImg.alt = `Screenshot ${index + 1} of ${images.length}`;
          // Keep the active thumbnail in view without scrolling the page.
          const t = thumbnails[index];
          if (strip && t) {
            // Measure from the strip itself (offsetLeft is relative to whatever
            // positioned ancestor the article happens to have).
            const offset = t.getBoundingClientRect().left - strip.getBoundingClientRect().left + strip.scrollLeft;
            strip.scrollTo({
              left: offset - (strip.clientWidth - t.clientWidth) / 2,
              behavior: reduceMotion.matches ? "auto" : "smooth",
            });
          }
        };

        // Slide the current image out, swap in the next once it has decoded
        // (so it never flashes half-loaded), then slide it in from the other side.
        const show = (index, dir) => {
          if (index === currentIndex) return;
          const token = ++swapToken;
          const src = images[index];
          currentIndex = index;
          carousel.dataset.current = index;
          highlight(index);
          preload(index + dir);
          if (!lightbox.classList.contains("hidden")) lightboxImg.src = src;

          const next = new Image();
          next.src = src;
          const decoded = (next.decode ? next.decode() : Promise.resolve()).catch(() => {});

          if (reduceMotion.matches) {
            decoded.then(() => {
              if (token === swapToken) mainImg.src = src;
            });
            return;
          }
          mainImg.style.setProperty("--slide-dir", dir);
          mainImg.classList.remove("is-entering");
          mainImg.classList.add("is-leaving");
          Promise.all([decoded, new Promise((r) => setTimeout(r, 180))]).then(() => {
            if (token !== swapToken) return;
            mainImg.src = src;
            mainImg.classList.replace("is-leaving", "is-entering");
            mainImg.getBoundingClientRect(); // commit the start position before sliding in
            mainImg.classList.remove("is-entering");
          });
        };

        const goPrev = (e) => {
          e?.stopPropagation();
          show(currentIndex - 1 < 0 ? images.length - 1 : currentIndex - 1, -1);
        };
        const goNext = (e) => {
          e?.stopPropagation();
          show(currentIndex + 1 >= images.length ? 0 : currentIndex + 1, 1);
        };

        // Lightbox (a modal dialog: focus moves in, stays in, and returns)
        let opener = null;
        let hideTimer = 0;
        const isOpen = () => !lightbox.classList.contains("hidden") && lightbox.classList.contains("opacity-100");

        const openLightbox = () => {
          clearTimeout(hideTimer);
          opener = document.activeElement;
          lightboxImg.src = images[currentIndex];
          lightboxImg.alt = `Screenshot ${currentIndex + 1} of ${images.length}`;
          lightbox.classList.remove("hidden");
          lightbox.getBoundingClientRect(); // start the fade from the hidden state
          lightbox.classList.replace("opacity-0", "opacity-100");
          lightboxImg.classList.replace("scale-95", "scale-100");
          lbClose?.focus({ preventScroll: true });
          preload(currentIndex + 1);
          preload(currentIndex - 1);
        };

        const closeLightbox = () => {
          if (!isOpen()) return;
          lightbox.classList.replace("opacity-100", "opacity-0");
          lightboxImg.classList.replace("scale-100", "scale-95");
          hideTimer = setTimeout(() => lightbox.classList.add("hidden"), reduceMotion.matches ? 0 : 300);
          if (opener && opener.isConnected) opener.focus({ preventScroll: true });
          opener = null;
        };

        mainImg.addEventListener("click", openLightbox);
        mainImg.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            openLightbox();
          }
        });
        expand?.addEventListener("click", openLightbox);

        lightbox.addEventListener("click", (e) => {
          if (e.target === lightbox || e.target === lightboxImg) closeLightbox();
        });
        lbClose?.addEventListener("click", (e) => {
          e.stopPropagation();
          closeLightbox();
        });

        prevBtn?.addEventListener("click", goPrev);
        nextBtn?.addEventListener("click", goNext);
        lbPrev?.addEventListener("click", goPrev);
        lbNext?.addEventListener("click", goNext);

        thumbnails.forEach((thumb, i) => {
          thumb.addEventListener("click", () => show(i, i > currentIndex ? 1 : -1));
        });

        // Swipe left/right on the image or the lightbox
        let touchX = null;
        let touchY = 0;
        const onTouchStart = (e) => {
          touchX = e.touches[0].clientX;
          touchY = e.touches[0].clientY;
        };
        const onTouchEnd = (e) => {
          if (touchX === null) return;
          const dx = e.changedTouches[0].clientX - touchX;
          const dy = e.changedTouches[0].clientY - touchY;
          touchX = null;
          if (images.length > 1 && Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.5) (dx < 0 ? goNext : goPrev)();
        };
        [stage, lightbox].forEach((el) => {
          el?.addEventListener("touchstart", onTouchStart, { passive: true });
          el?.addEventListener("touchend", onTouchEnd, { passive: true });
        });

        // Arrow keys / Escape / Tab (kept inside) while the lightbox is open
        const onKey = (e) => {
          if (!carousel.isConnected) return document.removeEventListener("keydown", onKey);
          if (!isOpen()) return;
          if (e.key === "ArrowLeft") goPrev();
          else if (e.key === "ArrowRight") goNext();
          else if (e.key === "Escape") closeLightbox();
          else if (e.key === "Tab") {
            const focusables = [lbClose, lbPrev, lbNext].filter(Boolean);
            const i = focusables.indexOf(document.activeElement);
            e.preventDefault();
            const step = e.shiftKey ? -1 : 1;
            focusables[(i + step + focusables.length) % focusables.length]?.focus();
          }
        };
        document.addEventListener("keydown", onKey);
        // Leaving the page with the viewer open must not leave a stale listener behind.
        document.addEventListener("astro:before-swap", () => document.removeEventListener("keydown", onKey), { once: true });

        preload(1);
      }

      initCarousel();
      document.addEventListener("astro:page-load", initCarousel);
    </script>
  </div>
)}

<style>
  .gallery-strip {
    scrollbar-width: none;
  }
  .gallery-strip::-webkit-scrollbar {
    display: none;
  }
</style>
