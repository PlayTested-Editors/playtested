---
import { type CollectionEntry } from "astro:content";
import SiteOptions from "../site.config.mjs";
import ScoreBadge from "./ScoreBadge.astro";
import { Image } from "astro:assets";

export interface Props {
  post: CollectionEntry<"article"> | CollectionEntry<"submissions">;
  showImage?: boolean;
  showCategory?: boolean;
  /** First visible row: load the thumbnail eagerly at high priority. */
  priority?: boolean;
}

const { post, showImage = true, showCategory = true, priority = false } = Astro.props;
const { title, pubDate, category, description, author, thumb, score, large, gallery } =
  post.data;

const formattedDate = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(pubDate);

// Fades the thumbnail in once it has loaded (see .img-fade in global.css).
const markLoaded = "this.classList.add('is-loaded')";
---

<li
  class="flex flex-row gap-6 py-4 border-b border-gray-500 dark:border-gray-800 items-start"
  data-reveal
  data-vt-card
  data-vt-slug={post.slug}
  data-hero-src={large ?? gallery?.[0]}
>
  {
    showImage && thumb && (
      <a
        href={`/article/${post.slug}/`}
        class="block shrink-0 relative post-card-thumb group overflow-hidden rounded-md img-skeleton thumb-glow"
      >
        <Image
          src={thumb}
          alt={title}
          width={224}
          height={128}
          loading={priority ? "eager" : "lazy"}
          fetchpriority={priority ? "high" : "auto"}
          decoding="async"
          onload={markLoaded}
          onerror={markLoaded}
          data-vt-hero
  class="img-fade w-20 h-26 sm:w-32 sm:h-20 lg:w-56 lg:h-32 object-cover rounded-md transition-transform duration-300 group-hover:scale-105 border border-gray-800 dark:border-gray-700"
        />
{typeof score === "number" && <ScoreBadge score={score} />}
      </a>
    )
  }

  <div class="flex-1 flex flex-col min-w-0">
    <div class="flex items-center justify-between gap-2">
<a
  href={`/article/${post.slug}/`}
  class="text-base sm:text-lg md:text-xl font-medium hover:underline hover:text-blue-600 dark:hover:text-blue-400 transition-colors flex-1 clamp-2-lines"
  data-vt-title
>

        {title}
        {
          SiteOptions.showAuthorsOnHomePage && author && (
            <span class="text-sm text-gray-500 dark:text-gray-400 ml-2">
              by {author}
            </span>
          )
        }
      </a>
      {
        showCategory && category && (
          <span class="ml-2 inline-block text-xs mb-8 bg-gray-100 text-gray-600 dark:bg-slate-700 dark:text-slate-300 px-2 py-1 rounded max-w-[120px] truncate whitespace-nowrap">
            {category}
          </span>
        )
      }
    </div>
    {
      description && (
        <p class="card-desc text-sm text-gray-900 dark:text-gray-400 mt-1 line-clamp-2">
          {description}
        </p>
      )
    }
   <div class="text-xs text-gray-700 dark:text-gray-500 mt-2 flex items-center flex-wrap gap-1">
      <time datetime={post.data.pubDate.toISOString()}>
        {formattedDate}
      </time>

      <span class="text-gray-400 mx-1">•</span>

      <span>By</span>
      <a
        href={`/author/${author.toLowerCase().replace(/\s+/g, '-')}/`}
        class="font-medium hover:underline hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
      >
        {author}
      </a>
    </div>
  </div>
</li>

<script>
  // Mark titles cut off at two lines: hovering the card then shows the whole
  // title (see .clamp-2-lines[data-clamped] in global.css).
  const markClamped = () =>
    document.querySelectorAll<HTMLElement>(".clamp-2-lines").forEach((el) => el.toggleAttribute("data-clamped", el.scrollHeight > el.clientHeight + 1));
  document.addEventListener("astro:page-load", () => {
    markClamped();
    document.fonts?.ready.then(markClamped);
  });
  let resizeTimer: ReturnType<typeof setTimeout>;
  addEventListener("resize", () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(markClamped, 200);
  });
</script>
