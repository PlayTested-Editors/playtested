---
import { formatScore } from "../lib/score";
export interface Props {
  score: number;
}
const { score } = Astro.props;
const rounded = Math.round(score);
---

{typeof score === "number" && (
  <div class={`score-badge score-outline-${rounded}`} aria-label={`Score: ${formatScore(score)} out of 10`}>{formatScore(score)}</div>

)}
