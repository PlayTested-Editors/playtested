---
import { formatScore } from "../lib/score";

interface Props {
  id?: string;
  title: string;
  description?: string;
  thumb?: string;
  url?: URL;
  score?: number | string;
  author?: string;
  type?: "article" | "home";
  /** Featured posts shown on the homepage share card. */
  featured?: { data: { title: string; thumb?: string; score?: number | null; description?: string } }[];
}

const {
  id = "review-card-element",
  title,
  description,
  thumb,
  url = Astro.url,
  score,
  type = "article",
  featured = [],
} = Astro.props;

const qrValue = url.href;

// Featured posts for the homepage card are passed in (keeps the content
// collection out of pages rendered in the Worker).
const featuredArticles = type === "home" ? featured.slice(0, 3) : [];
---

<!-- Share card (600x315): rendered off-screen and captured as a PNG by SocialShare. -->
<div
  id={id}
  class="fixed left-0 top-0 w-[600px] h-[315px] text-white overflow-hidden z-[-50] opacity-0 pointer-events-none"
  style="background: #0B1020; font-family: 'Segoe UI', system-ui, sans-serif;"
>
  <div class="relative w-full h-full flex flex-col">
    {
      thumb && (
        <div class="absolute inset-0 z-0 opacity-35">
          <img src={thumb} class="w-full h-full object-cover" alt="" crossorigin="anonymous" loading="eager" />
        </div>
      )
    }
    <div class="absolute inset-0 z-10" style="background: linear-gradient(to top, #0B1020 22%, rgba(11,16,32,0.82) 55%, rgba(11,16,32,0.35));"></div>

    <div class="relative z-20 flex flex-col h-full px-6 pt-5 pb-6">
      <!-- Top bar: brand left, QR right -->
      <div class="flex items-start justify-between gap-4 shrink-0">
        <div class="flex items-center gap-2.5">
          <img src="/favicon.svg" alt="" width="34" height="34" class="w-[34px] h-[34px]" />
          <span class="font-brand text-[22px] leading-none whitespace-nowrap">Play<span style="color: #B6F03C">Tested</span></span>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-[10px] text-slate-300 font-bold tracking-widest uppercase text-right leading-tight">
            {type === "home" ? "Scan to" : "Scan to read"}
            <br />
            {type === "home" ? "visit" : "full review"}
          </span>
          <div class="bg-white p-1 rounded-md shrink-0">
            <div class="card-qr-code" data-url={qrValue} />
          </div>
        </div>
      </div>

      <div class="flex-1 flex flex-col min-h-0">
        {
          type === "home" && (
            <div class="flex flex-col h-full justify-end gap-3">
              {description && (
                <p class="my-auto text-[13px] text-slate-200 leading-relaxed font-medium whitespace-normal break-words" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                  {description}
                </p>
              )}
              {featuredArticles.length > 0 && (
                <div class="flex gap-3 h-[128px] shrink-0">
                  {featuredArticles.map((article) => (
                    <div class="flex-1 min-w-0 rounded-lg overflow-hidden flex flex-col" style="background: rgba(22,33,58,0.92); border: 1px solid #24314F;">
                      {article.data.thumb && (
                        <div class="h-[62px] shrink-0 w-full relative">
                          <img src={article.data.thumb} class="w-full h-full object-cover" alt="" crossorigin="anonymous" loading="eager" />
                          {article.data.score != null && (
                            <span class="font-brand absolute right-1.5 top-1.5 rounded px-1.5 py-0.5 text-[11px] leading-none" style="background: #B6F03C; color: #0B1020">
                              {formatScore(article.data.score)}
                            </span>
                          )}
                        </div>
                      )}
                      <div class="p-2 flex-1 min-h-0">
                        <p class="font-brand m-0 text-[12px] leading-[1.25] text-white whitespace-normal break-words" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                          {article.data.title}
                        </p>
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </div>
          )
        }

        {
          type === "article" && (
            <div class="mt-auto flex flex-col gap-2.5">
              <div class="flex items-end gap-4 w-full">
                <h2 class="font-brand text-[26px] leading-[1.12] text-white flex-1 whitespace-normal break-words" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                  {title}
                </h2>
                {score && (
                  <div class="font-brand shrink-0 rounded-lg px-3 py-1.5 text-[28px] leading-none" style="background: #B6F03C; color: #0B1020">
                    {formatScore(score)}
                  </div>
                )}
              </div>
              {description && (
                <p class="text-[14px] text-slate-300 leading-snug break-words whitespace-normal" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                  {description}
                </p>
              )}
            </div>
          )
        }
      </div>
    </div>

    <!-- Brand strip -->
    <div class="absolute inset-x-0 bottom-0 z-20 h-[4px]" style="background: #B6F03C"></div>
  </div>
</div>

<script>
  import QRCode from "qrcode";

  function renderQRs() {
    const qrContainers = document.querySelectorAll(".card-qr-code");
    qrContainers.forEach((container) => {
      if (container.hasChildNodes()) return;

      const url = (container as HTMLElement).dataset.url;
      if (url) {
        QRCode.toDataURL(url, {
          width: 52,
          margin: 0,
          color: { dark: "#0B1020", light: "#ffffff" },
        })
          .then((dataUrl) => {
            const img = document.createElement("img");
            img.src = dataUrl;
            img.alt = "QR Code";
            img.className = "w-[52px] h-[52px] block"; // Matches width option
            container.appendChild(img);
          })
          .catch((err) => console.error("QR Error", err));
      }
    });
  }

  // Initial and after-swap
  renderQRs();
  document.addEventListener("astro:after-swap", renderQRs);
</script>
