---
// Studio shell (static, free to serve). Deep links under /studio/* are served
// this same page by the Worker; the app reads location.pathname to pick a view.
import App from "../../studio/App.svelte";
import "../../studio/studio.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>PlayTested Studio</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <script is:inline>
      try {
        const t = localStorage.getItem("theme") || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.classList.toggle("dark", t === "dark");
      } catch {}
    </script>
  </head>
  <body>
    <App client:only="svelte" />
  </body>
</html>
