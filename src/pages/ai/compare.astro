---
import BlogLayout from "../../layouts/BlogLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import GameSelector from "../../components/GameSelector.astro";
---

<BlogLayout title="AI Game Comparator" description="Compare two to four games with AI, alongside PlayTested's own review scores.">
  <Header />

  <section id="comparison" class="mb-16">
    <div
      class="mt-10 rounded-2xl border border-purple-100 bg-gradient-to-br from-purple-50 to-pink-50 p-5 shadow-lg sm:p-8 dark:border-slate-700 dark:from-slate-800 dark:to-slate-900"
    >
      <div class="mb-6 flex flex-col items-center space-y-4 text-center sm:flex-row sm:items-start sm:space-x-4 sm:space-y-0 sm:text-left">
        <div class="shrink-0 rounded-full bg-gradient-to-br from-purple-500 to-pink-500 p-3 shadow-md">
          <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
            ></path>
          </svg>
        </div>
        <div>
          <h1 class="text-2xl font-bold text-gray-900 sm:text-3xl dark:text-gray-100">AI Game Comparison</h1>
          <p class="mt-1 text-sm text-gray-600 sm:text-base dark:text-gray-300">Can't decide between games? Let AI help you choose.</p>
        </div>
      </div>

      <div class="mb-4 space-y-4">
        <div class="rounded-xl border border-purple-100 bg-white/50 p-4 backdrop-blur-sm sm:p-6 dark:border-slate-700 dark:bg-slate-800/50">
          <h2 class="mb-2 text-lg font-semibold text-gray-800 dark:text-gray-200">Quick comparison</h2>
          <ul class="space-y-1 text-sm text-gray-600 dark:text-gray-400">
            <li>⚡ <strong>Brief analysis:</strong> a concise comparison in a paragraph or two</li>
            <li>🎮 <strong>Key differences:</strong> gameplay, story and vibe at a glance</li>
            <li>📝 <strong>Our scores:</strong> see PlayTested's verdict for every game we've reviewed</li>
          </ul>
        </div>

        <GameSelector maxSelection={4} minSelection={2} buttonText="⚔️ Compare Games" id="comparator" />
      </div>
    </div>
  </section>

  <section class="mb-12 text-center">
    <div class="rounded-2xl border border-gray-200 bg-gray-50 p-6 sm:p-8 dark:border-slate-700 dark:bg-slate-800">
      <h2 class="mb-4 text-2xl font-bold text-gray-900 dark:text-gray-100">Powered by AI, grounded in our reviews</h2>
      <p class="mx-auto max-w-2xl text-gray-600 dark:text-gray-400">
        The comparison uses our own verdicts where we have them, so you get the AI's overview and PlayTested's scores side by side.
        Looking for something new instead? <a href="/ai/recommend/" class="font-semibold text-indigo-600 hover:underline dark:text-indigo-400">Get AI recommendations</a>.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-4 text-sm text-gray-500 dark:text-gray-400">
        <div class="flex items-center space-x-2"><span class="h-2 w-2 rounded-full bg-green-500"></span><span>RAWG game data</span></div>
        <div class="flex items-center space-x-2"><span class="h-2 w-2 rounded-full bg-indigo-500"></span><span>PlayTested reviews</span></div>
        <div class="flex items-center space-x-2"><span class="h-2 w-2 rounded-full bg-red-500"></span><span>Google Gemini Flash Lite</span></div>
        <div class="flex items-center space-x-2"><span class="h-2 w-2 rounded-full bg-purple-500"></span><span>OpenRouter</span></div>
      </div>
    </div>
  </section>

  <Footer />
</BlogLayout>
