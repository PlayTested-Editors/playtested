---
import BlogLayout from "../layouts/BlogLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<BlogLayout title="Page not found" description="That page doesn't exist on PlayTested.Net." noindex>
  <Header showTitle />
  <section class="min-h-[50vh] flex flex-col items-center justify-center text-center py-16 px-4">
    <p class="text-7xl font-black tracking-tight bg-gradient-to-br from-indigo-500 to-fuchsia-500 bg-clip-text text-transparent">404</p>
    <h1 class="mt-4 text-2xl sm:text-3xl font-semibold text-gray-900 dark:text-slate-100">Game over — this page doesn't exist</h1>
    <p class="mt-3 max-w-md text-gray-600 dark:text-slate-400">
      The link may be old or mistyped. Try searching for the game or review you were after.
    </p>
    <form action="/search/" method="get" class="mt-8 flex w-full max-w-md gap-2">
      <input
        name="q"
        type="search"
        placeholder="Search reviews…"
        class="flex-1 rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-800 px-4 py-2.5 text-gray-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-indigo-500"
      />
      <button class="rounded-lg bg-indigo-600 px-5 py-2.5 font-medium text-white hover:bg-indigo-700 transition-colors">Search</button>
    </form>
    <a href="/" class="mt-6 text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:underline">← Back to the homepage</a>
  </section>
  <Footer />
</BlogLayout>
