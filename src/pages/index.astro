---
import { getCollection, type CollectionEntry } from "astro:content";
import { isVisible } from "../lib/content";
import BlogLayout from "../layouts/BlogLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PostCard from "../components/PostCard.astro";
import FeaturedCard from "../components/FeaturedCard.astro";
import SiteOptions from "../site.config.mjs";

// Fetch both collections
const allArticles = await getCollection("article", isVisible);
const allSubmissions = await getCollection("submissions", isVisible);

// Combine them into a single array
type CombinedCollectionEntry =
  | CollectionEntry<"article">
  | CollectionEntry<"submissions">;
const allPosts: CombinedCollectionEntry[] = [...allArticles, ...allSubmissions];

// Sort all combined posts by publication date
const sortedPosts = allPosts.sort(
  (a, b) =>
    new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf(),
);

// Filter featured posts from the combined array
const featuredPosts = sortedPosts
  .filter((post) => post.data.featured)
  .slice(0, SiteOptions.numberOfFeaturedPostsOnHomePage || 12);

// Slice the latest posts from the combined, sorted array
const latestPosts = sortedPosts.slice(
  0,
  SiteOptions.numberOfLatestPostsOnHomePage || 6,
);

const showCategory = SiteOptions.showCategoryOnPosts || false;

// carousel settings
const visible = 3;
const pages = Math.max(featuredPosts.length - visible + 1, 1);
---

<BlogLayout title={SiteOptions.siteTitle}>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        url: Astro.url.origin,
        name: "PlayTested.Net",
        potentialAction: {
          "@type": "SearchAction",
          target: `${Astro.url.origin}/search?q={search_term_string}`,
          "query-input": "required name=search_term_string",
        },
      })}
    />
  </Fragment>

  <Header homeFeatured={featuredPosts.slice(0, 3)} />

  {
    SiteOptions.showFeaturrdPostsOnHomePage && featuredPosts.length > 0 && (
      <section class="lg:pt-6 pb-8">
        <h2 class="mt-0 mb-2 text-2xl font-semibold text-center">
          Featured Posts
        </h2>

        <div class="relative">
          <button
            id="carousel-prev"
            class="absolute left-0 top-2/7 -translate-y-1/2 z-20 p-4 bg-white dark:bg-slate-700 rounded-full shadow-lg text-2xl disabled:opacity-50 cursor-pointer transition hover:shadow-xl motion-safe:active:scale-90"
          >
            ❮
          </button>
          <button
            id="carousel-next"
            class="absolute right-0 top-2/7 -translate-y-1/2 z-20 p-4 bg-white dark:bg-slate-700 rounded-full shadow-lg text-2xl disabled:opacity-50 cursor-pointer transition hover:shadow-xl motion-safe:active:scale-90"
          >
            ❯
          </button>

          <!-- clip-x: clip sideways only, so hovered cards can lift without their glow being cut -->
          <div id="carousel-viewport" class="clip-x touch-pan-y">
            <div
              id="carousel-track"
              class="flex transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] items-stretch"
            >
              {featuredPosts.map((post, i) => (
                <div class="carousel-item w-full sm:w-1/2 lg:w-1/3 flex-shrink-0 px-2 clip-x h-auto">
                  <div class="h-full flex flex-col">
                    <FeaturedCard post={post} priority={i < visible} />
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div
            id="carousel-indicators"
            class="flex justify-center mt-4 space-x-2"
          >
            <div class="w-6 h-2 rounded bg-gray-400 dark:bg-gray-700" />

            {Array.from({ length: pages }, (_, p) => (
              <button
                class="indicator w-6 h-2 rounded bg-gray-300 dark:bg-gray-600 cursor-pointer transition-all duration-300"
                data-page={p}
                aria-label={`Featured posts, slide ${p + 1}`}
              />
            ))}

            <div class="w-6 h-2 rounded bg-gray-400 dark:bg-gray-700" />
          </div>
        </div>
      </section>
    )
  }

  <section class="py-1">
    {
      SiteOptions.labels.latestPosts && (
        <h2 class="text-2xl font-semibold mb-5 text-center" data-reveal>
          {SiteOptions.labels.latestPosts}
        </h2>
      )
    }
    <ul class="grid grid-cols-1 lg:grid-cols-2 gap-x-6 gap-y-6">
      {
        latestPosts.map((post) => (
          <PostCard post={post} showCategory={showCategory} />
        ))
      }
    </ul>
    {
      sortedPosts.length > latestPosts.length && (
        <div class="text-center mt-8" data-reveal>
          <a
            href="/blog/page/1/"
            class="group inline-flex items-center px-6 py-3 text-sm font-medium text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 rounded-md transition motion-safe:active:scale-[0.97]"
          >
            {SiteOptions.labels.viewAllPosts}
            <svg
              class="ml-2 w-4 h-4 transition-transform duration-300 motion-safe:group-hover:translate-x-1"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"
              />
            </svg>
          </a>
        </div>
      )
    }
    <Footer />
  </section>
</BlogLayout>

<script>
  document.addEventListener("astro:page-load", () => {
    const track = document.getElementById("carousel-track");
    if (!track) return; // Exit if carousel is not on this page

    const viewport = document.getElementById("carousel-viewport");
    const prevBtn = document.getElementById("carousel-prev") as HTMLButtonElement | null;
    const nextBtn = document.getElementById("carousel-next") as HTMLButtonElement | null;
    const indicators = Array.from(document.querySelectorAll<HTMLButtonElement>(".indicator"));
    const itemCount = track.children.length;

    // Matches the item widths in the markup: w-full / sm:w-1/2 / lg:w-1/3
    function getVisibleCount() {
      const w = window.innerWidth;
      if (w < 640) return 1;
      if (w < 1024) return 2;
      return 3;
    }

    let idx = 0;
    // Furthest start position that still fills the view with cards.
    const maxIdx = () => Math.max(0, itemCount - getVisibleCount());

    function updateButtons() {
      if (prevBtn) prevBtn.disabled = idx <= 0;
      if (nextBtn) nextBtn.disabled = idx >= maxIdx();
    }

    function updateIndicators() {
      // There is one indicator per 3-card position, so narrower views share the last one.
      const current = Math.min(idx, indicators.length - 1);
      indicators.forEach((btn, j) => {
        const active = j === current;
        btn.classList.toggle("bg-gray-800", active);
        btn.classList.toggle("dark:bg-gray-200", active);
        btn.classList.toggle("bg-gray-300", !active);
        btn.classList.toggle("dark:bg-gray-600", !active);
        btn.classList.toggle("w-10", active);
        btn.classList.toggle("w-6", !active);
      });
    }

    function slide() {
      if (!track) return;
      idx = Math.min(Math.max(idx, 0), maxIdx());
      track.style.transform = `translateX(-${(idx * 100) / getVisibleCount()}%)`;
      updateButtons();
      updateIndicators();
    }

    const go = (step: number) => {
      idx += step;
      slide();
    };

    prevBtn?.addEventListener("click", () => go(-1));
    nextBtn?.addEventListener("click", () => go(1));

    indicators.forEach((btn) => {
      btn.addEventListener("click", () => {
        idx = parseInt(btn.dataset.page ?? "0", 10);
        slide();
      });
    });

    // Swipe left/right on touch screens
    let touchX: number | null = null;
    let touchY = 0;
    viewport?.addEventListener(
      "touchstart",
      (e) => {
        touchX = e.touches[0].clientX;
        touchY = e.touches[0].clientY;
      },
      { passive: true },
    );
    viewport?.addEventListener(
      "touchend",
      (e) => {
        if (touchX === null) return;
        const dx = e.changedTouches[0].clientX - touchX;
        const dy = e.changedTouches[0].clientY - touchY;
        touchX = null;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.5) go(dx < 0 ? 1 : -1);
      },
      { passive: true },
    );

    // Window listeners outlive the page under <ClientRouter />; drop them on navigation.
    const cleanup = new AbortController();
    window.addEventListener("resize", slide, { signal: cleanup.signal });
    document.addEventListener("astro:before-swap", () => cleanup.abort(), { once: true });

    // Initial setup
    slide();
  });
</script>
