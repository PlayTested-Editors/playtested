---
import "@fontsource/chakra-petch/700.css"
import "../styles/global.css"
import SiteOptions from "../site.config.mjs"
import { ClientRouter } from "astro:transitions";
import ChatWidget from "../components/ChatWidget.astro";

export interface Props {
  title: string
  description?: string
  /** Canonical path when the request URL differs (live fallback, preview). */
  canonicalPath?: string
  noindex?: boolean
  /** Share-preview image (path or URL); defaults to the branded card. */
  image?: string
  type?: "website" | "article"
}

const { title = SiteOptions.siteTitle, description = SiteOptions.siteSubTitle, canonicalPath, noindex = false, image, type = "website" } = Astro.props
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site)
// Share previews need an absolute image URL.
const ogImage = new URL(image || "/og-default.png", Astro.site).href
// Analytics only on the production site, so dev/testing traffic stays out of GA.
const isProduction = (import.meta.env.PUBLIC_SITE_ENV ?? "production") === "production"

const isHome = Astro.url.pathname === "/";
const pageTitle = isHome 
  ? SiteOptions.siteHomeTitle 
  : (title === SiteOptions.siteTitle ? title : `${title} | ${SiteOptions.siteTitle}`);


const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "name": "PlayTested.Net",
      "url": "https://playtested.net",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://playtested.net/search?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "Organization",
      "name": "PlayTested.Net",
      "url": "https://playtested.net",
      "logo": "https://playtested.net/icon-512.png"
    }
  ]
})
---
<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonical} />
    {(noindex || !isProduction) && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SiteOptions.siteTitle} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0B1020" />
    <title>{pageTitle}</title>
    <slot name="head" />
    
    <ClientRouter />
    <!-- Images fade in via an inline onload; without JS, just show them. -->
    <noscript><style>.img-fade { opacity: 1 !important; }</style></noscript>

    <link rel="alternate" type="application/rss+xml" title="PlayTested.Net RSS" href={`${Astro.url.origin}/rss.xml`} />

    <script is:inline>
      // Theme initialization - prevents FOUC
      // Storage access throws when site data is blocked; fall back to the OS setting.
      const getTheme = () => {
        let stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch {}
        return stored || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      };
      
      const setTheme = (theme) => {
        document.documentElement.classList.toggle("dark", theme === "dark");
        document.documentElement.setAttribute("data-theme", theme);
      };

      setTheme(getTheme());

      document.addEventListener("astro:after-swap", () => setTheme(getTheme()));
    </script>
    {isProduction && SiteOptions.gTag && (
      <script
        data-category="analytics"
        is:inline
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${SiteOptions.gTag}`}
      ></script>

      <script data-category="analytics" is:inline define:vars={{gTag: SiteOptions.gTag}}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag("js", new Date());

        gtag("config", gTag);
      </script>
    )}
    <script type="application/ld+json" set:html={schema}></script>
  </head>

  <body class="bg-gray-200 text-gray-900 dark:bg-slate-900 dark:text-slate-200 transition-colors duration-300 min-h-full">
    <main class="max-w-[1500px] mx-auto px-4 sm:px-6 lg:px-8">
      <slot />
    </main>

    <script is:inline src="/scripts/theme-toggle.js"></script>
    <script>
      // Scroll reveal, shared-element names for card -> article, hero warm-up.
      import "../scripts/motion";
    </script>
    <ChatWidget />
    {(SiteOptions as any).ads.adsterra.enabled && (SiteOptions as any).ads.adsterra.popunderEnabled && (SiteOptions as any).ads.adsterra.popunderId && (
      <script is:inline type='text/javascript' src={`//pl28747188.effectivegatecpm.com/52/03/7f/52037f86ba5e341879c1fddb90988d0d.js`}></script>
    )}
  </body>
</html>
