{
  "name": "storyteller",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host",
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --env dev",
    "build:search": "node scripts/build-search-index.mjs",
    "preview": "astro preview",
    "db:migrate:dev": "wrangler d1 migrations apply DB --remote",
    "sync:d1": "node scripts/sync-d1.mjs",
    "deploy:dev": "node scripts/build.mjs --env dev && node scripts/sync-d1.mjs && wrangler deploy",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.4.2",
    "@astrojs/svelte": "^7.2.5",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.8",
    "astro": "^5.12.8",
    "diff": "^8.0.4",
    "html-to-image": "^1.11.13",
    "marked": "^16.1.2",
    "minisearch": "^7.1.2",
    "qrcode": "^1.5.4",
    "svelte": "^5.57.1",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.9.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "^4.20260113.0",
    "wrangler": "^4.59.1"
  },
  "engines": {
    "node": ">=18.17"
  }
}
