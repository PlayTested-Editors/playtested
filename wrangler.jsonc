// Cloudflare Workers config (static assets + Worker fallback).
//
// Built pages in ./dist are served straight from the asset layer — free,
// unlimited, and they never invoke the Worker. The Worker only runs for URLs
// with no built file: /api/*, /studio/*, brand-new articles that haven't been
// built yet (live fallback), and 404s. See src/worker.ts.
//
// This is the DEV environment (deployed from the `dev` branch).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "playtested-dev",
  // PlayTested's own Cloudflare account (lyndongaming@gmail.com), separate
  // from other projects so free-plan limits can't collide.
  "account_id": "3290294832f56e48f5c04f91d5d87634",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "observability": { "enabled": true },
  "vars": {
    "SITE_ENV": "dev",
    "GITHUB_REPO": "PlayTested-Editors/playtested",
    "GITHUB_BRANCH": "dev",
    "GITHUB_DEPLOY_WORKFLOW": "deploy-dev.yml",
    "CF_ACCOUNT_ID": "3290294832f56e48f5c04f91d5d87634"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "playtested-dev",
      "database_id": "d4f067ec-2105-42ad-bc0d-83dff2dbdbac",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "CACHE", "id": "60b62bf7520342d4979cb5c345ea5abb" }
  ],
  // No R2 binding: studio uploads are staged in KV (src/lib/server/media.ts).
  // Add { "binding": "MEDIA", "bucket_name": "…" } here once R2 is enabled.
  "vectorize": [
    { "binding": "VECTORS", "index_name": "playtested-dev-chunks" }
  ],
  "ai": { "binding": "AI" },
  // One trigger every 10 minutes: usage watchdog, scheduled-post rebuilds,
  // search-index catch-up and rate-limit cleanup.
  "triggers": { "crons": ["*/10 * * * *"] }
  // Per-visitor rate limits live in D1 (see src/lib/server/guards.ts): the
  // ratelimits binding didn't enforce on the free plan when tested.
}
